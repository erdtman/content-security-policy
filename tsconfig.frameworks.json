{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The frameworks are installed with --no-save, and their own declarations
    // are not this package's problem: only their fit with ours is.
    "skipLibCheck": true,
    "lib": ["es2022", "dom"]
  },
  // The base config excludes this file, and exclude is inherited, so it has to
  // be cleared here or there would be nothing left to check.
  "exclude": [],
  "include": ["lib/index.d.ts", "test/types/frameworks.ts"]
}
