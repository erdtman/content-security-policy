  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdtman/content-security-policy.git"
  },
  "bugs": {
    "url": "https://github.com/erdtman/content-security-policy/issues"
  },
  "homepage": "https://github.com/erdtman/content-security-policy#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "clean": "rm -rf coverage/",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:types": "tsc --noEmit",
    "pretest": "npm run lint && npm run lint:types",
    "test": "node --test \"test/*.js\"",
    "watch": "node --test --watch \"test/*.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/*.js\""
  },
  "engines": {
    "node": ">=18"
  }
