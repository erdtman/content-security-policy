{
  "name": "content-security-policy",
  "description": "Add a Content-Security-Policy header, on Express, Connect, Fastify, Koa, Hono, Hapi, or anything that can set a header.",
  "version": "1.0.0",
  "author": {
    "name": "Samuel Erdtman",
    "email": "samuel@erdtman.se"
  },
  "keywords": [
    "express",
    "connect",
    "fastify",
    "koa",
    "hapi",
    "hono",
    "middleware",
    "content-security-policy",
    "security",
    "csp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdtman/content-security-policy.git"
  },
  "bugs": {
    "url": "https://github.com/erdtman/content-security-policy/issues"
  },
  "homepage": "https://github.com/erdtman/content-security-policy#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "clean": "rm -rf coverage/",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:types": "tsc --noEmit",
    "pretest": "npm run lint && npm run lint:types",
    "test": "node --test \"test/*.js\"",
    "test:frameworks": "npm install --no-save --no-package-lock express fastify koa @hapi/hapi hono @hono/node-server @types/express @types/koa && tsc --project tsconfig.frameworks.json && node --test test/frameworks.js",
    "watch": "node --test --watch \"test/*.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/*.js\"",
    "mutation": "npx --yes -p @stryker-mutator/core@9 -p typescript@5 stryker run",
    "prepublishOnly": "npm run lint && npm run lint:types && npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
