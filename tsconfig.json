{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": false
  },
  "include": ["lib/index.d.ts", "test/types"],
  // Needs the frameworks installed; tsconfig.frameworks.json checks it under
  // `npm run test:frameworks`.
  "exclude": ["test/types/frameworks.ts"]
}
